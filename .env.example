# Copy this file to .env and fill in the values.

# The mail domain this server accepts mail for. Every address at this domain
# (any local part) is accepted and readable in the web interface.
DOMAIN=mail.example.com

# The single password used to sign in to the web interface.
APP_PASSWORD=change-me

# Web interface (HTTP) listener.
HOST=0.0.0.0
PORT=3000

# SMTP listener. Port 25 is the standard inbound mail port; change it if you
# front this process with a real MTA or need to run unprivileged.
SMTP_PORT=25

# Where the SQLite database and session key are stored.
DATA_DIR=./data

# Largest message accepted by SMTP, in bytes.
MAX_MESSAGE_BYTES=10485760

# Add "Secure" to the session cookie. Turn this on when the web interface is
# served over HTTPS.
SECURE_COOKIES=false
